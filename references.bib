@article{wenzhonglín2025,
	title = {因果·影响·相关与预测辨析},
	author = {{温忠麟},  and {马鹏},  and {孟进},  and {王一帆}, },
	year = {2025},
	month = {06},
	date = {2025-06-25},
	journal = {心理学报},
	pages = {1108},
	volume = {57},
	number = {6},
	doi = {10.3724/SP.J.1041.2025.1108},
	url = {https://journal.psych.ac.cn/xlxb/CN/10.3724/SP.J.1041.2025.1108},
	note = {Field: 针对温忠麟等人(2024b)提出的影响关系, 葛枭语(2025)撰文提出下面质疑：(1){\textquotedblleft}影响关系{\textquotedblright}缺乏明确定义; (2)影响关系与因果关系区分不开; (3)不能因为因果目标无法达到便创设新目标; (4)所谓的影响关系应当称为{\textquotedblleft}预测{\textquotedblright}。本文对此做出回应：(1)影响关系定义严密, 用的是{\textquotedblleft}属加种差{\textquotedblright}的定义方法; (2)因果关系一定是影响关系, 但影响关系不一定是因果关系; (3)建立影响关系可以是非实验研究的一种目标, 优于仅仅建立相关关系; (4)预测是对变量关系的应用, 但不是关系本身, 与影响关系不相称。},
	langid = {pinyin}
}

@article{gexiaoyu2025,
	title = {所谓影响关系有待商榷：对温忠麟等人(2024)的评论},
	author = {{葛枭语}, },
	year = {2025},
	month = {06},
	date = {2025-06-25},
	journal = {心理学报},
	pages = {1098},
	volume = {57},
	number = {6},
	doi = {10.3724/SP.J.1041.2025.1098},
	url = {https://journal.psych.ac.cn/xlxb/CN/10.3724/SP.J.1041.2025.1098},
	note = {Field: 温忠麟等人(2024)在《心理学报》发文聚焦长期以来用法模糊的{\textquotedblleft}影响{\textquotedblright}一词, 并提出{\textquotedblleft}影响关系{\textquotedblright}概念, 或将改变汉语心理学界接下来的语用实践。然而, 该文存在若干疑点：{\textquotedblleft}影响{\textquotedblright}一词无论汉英、无论大众或学界, 均视为因果语言, 难以被作者说服相信不传达因果意涵; {\textquotedblleft}影响关系{\textquotedblright}缺失明确定义, 似与因果关系并无本质差异; 混淆目标与实现目标的手段, 由于在手段上无法为因果目标提供因果证据, 便创设一个不同于因果和相关关系的第三种目标, 是奇怪的。更重要的是, 共变且有方向性的变量关系并非如作者所言未被命名, 一直被学界称为{\textquotedblleft}预测{\textquotedblright}。据此, 此评论旨在提醒学界同仁考虑描述相关情形的其它可能办法、审慎决策是否将所谓{\textquotedblleft}影响关系{\textquotedblright}引入研究。},
	langid = {pinyin}
}

